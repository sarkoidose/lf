# LF Configuration

set shell zsh
set icons true
set drawbox true
set info size
set preview true

# Preview
set previewer ~/.config/lf/pv.sh
set cleaner ~/.config/lf/cleaner.sh

# Simple delete command
cmd delete %rm -rf "$f"

# Keybindings
map d delete
map D delete
map <delete> delete

map . set hidden!
map <enter> open
map e $editor "$f"
map i $pager "$f"
map o &$opener "$f"

map n push :mkdir<space>
map N push :touch<space>

map gd cd ~/Downloads
map gP cd ~/Pictures/wallpapers
map gC cd ~/.config/lf
map gI cd ~/Images
