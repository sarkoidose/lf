# =======================================================
# LF CONFIGURATION - ENHANCED VERSION
# =======================================================

# --- Global Options ---
set shell zsh
set icons true
set drawbox
set info size
set preview true
set ifs "\n"

# --- Preview Management ---
set previewer ~/.config/lf/pv.sh
set cleaner ~/.config/lf/cleaner.sh

# --- Custom Commands ---

# Move to trash
cmd trash ${
    clear
    trash-put ${(f)fx}
    lf -remote "send $id echo Files moved to trash"
}

# Extract archives
cmd extract ${
    case "$f" in
        *.tar.bz2) tar xjf "$f" ;;
        *.tar.gz) tar xzf "$f" ;;
        *.bz2) bunzip2 "$f" ;;
        *.rar) unrar x "$f" ;;
        *.gz) gunzip "$f" ;;
        *.tar) tar xf "$f" ;;
        *.tbz2) tar xjf "$f" ;;
        *.tgz) tar xzf "$f" ;;
        *.zip) unzip "$f" ;;
        *.7z) 7z x "$f" ;;
        *)
            lf -remote "send $id echo ❌ Unsupported format: $f"
            exit 1
            ;;
    esac && lf -remote "send $id echo ✓ Extraction successful"
}

# Create directory
cmd mkdir :{
    printf "Folder name: "
    read -r ans || return
    [ -z "$ans" ] && return
    if mkdir -p "$ans"; then
        lf -remote "send $id echo ✓ Folder created: $ans"
    else
        lf -remote "send $id echo ❌ Error: Failed to create folder"
    fi
}

# Create file
cmd mkfile :{
    printf "File name: "
    read -r ans || return
    [ -z "$ans" ] && return
    if touch "$ans"; then
        lf -remote "send $id echo ✓ File created: $ans"
    else
        lf -remote "send $id echo ❌ Error: Failed to create file"
    fi
}

# Search with FZF (Jump)
cmd fzf_jump ${
    res="$(find . -maxdepth 3 -type f -o -type d 2>/dev/null | fzf --reverse --header='Go to:')"
    if [ -n "$res" ]; then
        if [ -d "$res" ]; then
            lf -remote "send $id cd \"$res\""
        else
            lf -remote "send $id select \"$res\""
        fi
    fi
}

# Gnosis-Diff (Compare two files)
cmd gdiff ${
    GNOSIS_DIFF="${GNOSIS_DIFF:-$HOME/gemini/gnosis-diff/gnosis_diff.py}"
    
    if [ ! -f "$GNOSIS_DIFF" ]; then
        lf -remote "send $id echo ❌ Error: gnosis-diff not found at $GNOSIS_DIFF"
        return
    fi
    
    if [ $(echo "$fx" | wc -l) -ge 2 ]; then
        python "$GNOSIS_DIFF" "$fx" "$f"
    else
        lf -remote "send $id echo ⚠️ Mark a file first with [Space]"
    fi
}

# --- Keybindings ---

map . set hidden!
map e $$EDITOR "$f"
map i $$PAGER "$f"
map o &xdg-open "$f"

# Deletion
map D trash
map <delete> trash

# Utilities
map X extract
map Y ${{ printf "%s" "$f" | wl-copy && lf -remote "send $id echo ✓ Path copied" }}
map n mkdir
map N mkfile
map f fzf_jump
map gd gdiff

# Quick navigation
map gD cd ~/Downloads
map gP cd ~/Pictures/wallpapers
map gC cd ~/.config/lf
map gI cd ~/Images
