# =======================================================
# LF CONFIGURATION - REFINED
# =======================================================

# --- Options ---
set shell zsh
set icons true
set drawbox
set info size
set preview true
set ifs "\n"

# --- Preview ---
set previewer ~/.config/lf/pv.sh
set cleaner ~/.config/lf/cleaner.sh

# --- Commands ---

# Move to trash
cmd trash ${{
    trash-put $fx
    lf -remote "send $id echo Files moved to trash"
}}

# Extract archives
cmd extract ${{
    case "$f" in
        *.tar.bz2|*.tbz2) tar xjf "$f" ;;
        *.tar.gz|*.tgz) tar xzf "$f" ;;
        *.bz2) bunzip2 "$f" ;;
        *.rar) unrar x "$f" ;;
        *.gz) gunzip "$f" ;;
        *.tar) tar xf "$f" ;;
        *.zip) unzip "$f" ;;
        *.7z) 7z x "$f" ;;
        *) echo "Format non supporté" ;;
    esac
}}

# Create directory
cmd mkdir :{{
    printf "Nom du dossier: "
    read ans
    mkdir -p "$ans"
}}

# Create file
cmd mkfile :{{
    printf "Nom du fichier: "
    read ans
    touch "$ans"
}}

# --- Keybindings ---

map . set hidden!
map e $$EDITOR "$f"
map i $$PAGER "$f"
map o &xdg-open "$f"

# Deletion
map D trash
map <delete> trash

# Utilities
map X extract
map Y ${{ printf "%s" "$f" | wl-copy && lf -remote "send $id echo Chemin copié" }}
map n mkdir
map N mkfile

# Quick navigation
map gD cd ~/Downloads
map gP cd ~/Pictures/wallpapers
map gC cd ~/.config/lf
map gI cd ~/Images
